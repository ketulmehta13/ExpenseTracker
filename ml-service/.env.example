# Copy to ml-service/.env (git-ignored) and run: uvicorn app.main:app --env-file .env
SUPABASE_URL=https://your-project-id.supabase.co
# The public anon/publishable key: it identifies the project and grants nothing by itself
SUPABASE_ANON_KEY=your-publishable-key
ALLOWED_ORIGINS=http://localhost:5173,https://ketul-expense-tracker.vercel.app
AUTH_CACHE_SECONDS=60
