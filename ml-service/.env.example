# Copy to ml-service/.env (git-ignored) and run: uvicorn app.main:app --env-file .env
SUPABASE_URL=https://your-project-id.supabase.co
# The public anon/publishable key: it identifies the project and grants nothing by itself
SUPABASE_ANON_KEY=your-publishable-key
ALLOWED_ORIGINS=http://localhost:5173,https://ketul-expense-tracker.vercel.app
AUTH_CACHE_SECONDS=60
USER_CONTEXT_CACHE_SECONDS=60
# Where trained models are read from (default: ml-service/models)
# MODEL_DIR=/srv/models

# Optional LLM for the quick-add fallback and the monthly summary (both work without one).
# none | ollama (local, free) | openai (any OpenAI-compatible endpoint, e.g. a free hosted tier)
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434          # Ollama default; for openai, the endpoint's /v1 URL
# LLM_API_KEY=                                 # only for hosted endpoints; never commit it
LLM_TIMEOUT_SECONDS=20

# Help-center search (POST /v1/help). Set EMBEDDING_MODEL= (empty) for keyword search only.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=/srv/models/embeddings
