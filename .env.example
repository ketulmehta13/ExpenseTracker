# ==============================================================================
# EXPENSE TRACKER — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or .env.local in the relevant directory.
# NEVER commit real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (React + Vite + Supabase) -> place in frontend/.env.local
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (Safe to use in browser)
# NEVER put the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Optional) Base URL of the self-hosted ML service (ml-service/), e.g. http://localhost:8000.
# Leave empty to hide ML features (Quick Add, suggestions, insights, bill scanning, chatbot).
# The ML service's own variables are in ml-service/.env.example.
VITE_ML_API_URL=

# (Optional) Subscriptions: the Pro plan, upgrade prompts and Razorpay billing. Off by
# default, which makes every feature free and unlimited (exports, history, categories).
VITE_ENABLE_BILLING=false
