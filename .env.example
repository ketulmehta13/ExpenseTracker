# ==============================================================================
# EXPENSE TRACKER — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or .env.local in the relevant directory.
# NEVER commit real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (React + Vite + Supabase) -> place in frontend/.env.local
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (Safe to use in browser)
# NEVER put the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Optional) Sentry DSN for error monitoring & performance tracking
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# BACKEND (Legacy Django REST Framework / Standalone Service) -> place in backend/.env
# Note: The active production frontend directly connects to Supabase.
# ------------------------------------------------------------------------------
# Django secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-django-secret-key-here

# Debug mode: must be False in production
DEBUG=False

# Database URL for PostgreSQL (Render, Railway, or Supabase DB)
DATABASE_URL=postgresql://user:password@localhost:5432/expensetracker_db

# Frontend production URL for strict CORS & CSRF whitelist
FRONTEND_URL=https://ketul-expense-tracker.vercel.app

# Optional Sentry DSN for backend error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
